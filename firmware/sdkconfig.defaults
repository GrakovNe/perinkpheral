CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# GPIO16/17 are UART0 TX/RX on the C6 and here they are the display's
# BUSY and CS. Nothing but the ROM may print there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 100 Hz makes pdMS_TO_TICKS(5) zero: a polling task then never sleeps.
CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Two OTA slots and rollback from day one: neither the bootloader nor the
# partition table can be changed over the air later.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The host loop is the main task and applications run on its stack: the
# interpreter may take 6 KB of it (d_m3MaxNativeStack), the host needs the rest.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Built for size: the firmware has to fit a 1.44 MB slot with TLS and the
# full set of root certificates in it. It is also what lets the wasm
# interpreter chain its operations as tail calls instead of growing the stack.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The device asks servers and is never one over TLS: its own page is plain HTTP.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# The battery profile: the chip sleeps whenever nothing runs (light sleep),
# switched on and off at run time by the power setting.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# With a computer on the other end of the cable it does not: the console
# and flashing over USB go on working on the bench.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Memory. The radio's buffers at their defaults are sized for a device that
# moves megabytes; this one asks for a kilobyte a few times an hour and
# serves one page. Every static buffer here is 1.6 KB that an application
# or a TLS session does not have.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# No enterprise networks, and the other radio of the chip (Thread, Zigbee)
# is not used at all.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_IEEE802154_ENABLED=n
# TLS takes its buffers when it needs them and gives them back, instead of
# holding 20 KB for as long as a session is open; and it does not keep the
# server's certificate once it has checked it.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# No aggregation: it is for throughput, and its reordering buffers are memory.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
# A smaller TCP window: less of an answer waits in memory for TLS to take it.
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# mDNS: one service (the page), no console commands of its own.
CONFIG_MDNS_MAX_SERVICES=1
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# Memory before speed: this device moves a few kilobytes at a time. The
# radio's code and the scheduler's run from flash instead of RAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# Nothing on the device speaks IPv6, and no source of data needs it.
CONFIG_LWIP_IPV6=n
